    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "i18next": "^23.2.11",
    "i18next-browser-languagedetector": "^7.1.0",
    "i18next-http-backend": "^4.0.10",
    "loc-i18next": "^0.1.5",
    "normalize.css": "^8.0.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"

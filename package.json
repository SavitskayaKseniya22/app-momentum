{
  "version": "0.1.0",
  "description": "momentum",
  "private": true,
  "name": "momentum",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "start": "npm run dev",
